#!/bin/sh
# wal-qt — build a qt6ct colour scheme from the current pywal16 palette, so Qt6
# apps (with QT_QPA_PLATFORMTHEME=qt6ct) follow the wallpaper colours.
#
# Only the colour scheme is generated; ~/.config/qt6ct/qt6ct.conf is created
# once and then left alone, so tweaks made in the qt6ct GUI are preserved.
set -eu

CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/wal"
CONF="${XDG_CONFIG_HOME:-$HOME/.config}/qt6ct"
SCHEME="$CONF/colors/pywal.conf"

[ -f "$CACHE/colors.sh" ] || { echo "wal-qt: no palette (run wal first)" >&2; exit 1; }
mkdir -p "$CONF/colors"
. "$CACHE/colors.sh"

h() { printf '%s' "${1#\#}"; }   # strip a leading '#'

# shade <rrggbb> <delta> — lighten (+) / darken (-) each channel; emits #AARRGGBB
shade() {
	python3 - "$1" "$2" <<'PY'
import sys
h = sys.argv[1].lstrip('#'); d = int(sys.argv[2])
r, g, b = (int(h[i:i+2], 16) for i in (0, 2, 4))
c = lambda x: max(0, min(255, x + d))
print("#ff%02x%02x%02x" % (c(r), c(g), c(b)))
PY
}

bg=$(h "${background:-#000000}")
fg=$(h "${foreground:-#ffffff}")
c0=$(h "${color0:-#000000}")
c1=$(h "${color1:-#ff0000}")
c4=$(h "${color4:-#0000ff}")
c5=$(h "${color5:-#ff00ff}")
c8=$(h "${color8:-#808080}")

light=$(shade "$bg" 40)
midlight=$(shade "$bg" 25)
dark=$(shade "$bg" -25)
mid=$(shade "$bg" -12)
shadow=$(shade "$bg" -50)

# Colour order is QPalette::ColorRole (Qt6):
#   WindowText, Button, Light, Midlight, Dark, Mid, Text, BrightText, ButtonText,
#   Base, Window, Shadow, Highlight, HighlightedText, Link, LinkVisited,
#   AlternateBase, NoRole, ToolTipBase, ToolTipText, PlaceholderText, Accent
active="#ff$fg, #ff$bg, $light, $midlight, $dark, $mid, #ff$fg, #ff$c1, #ff$fg, #ff$bg, #ff$bg, $shadow, #ff$c4, #ff$bg, #ff$c4, #ff$c5, #ff$c0, #ff$bg, #ff$c0, #ff$fg, #80$fg, #ff$c4"
disabled="#ff$c8, #ff$bg, $light, $midlight, $dark, $mid, #ff$c8, #ff$c1, #ff$c8, #ff$bg, #ff$bg, $shadow, #ff$c4, #ff$c8, #ff$c4, #ff$c5, #ff$c0, #ff$bg, #ff$c0, #ff$c8, #80$c8, #ff$c4"

cat > "$SCHEME" <<EOF
# pywal16 colour scheme for qt6ct — generated by wal-qt, do not edit by hand.
[ColorScheme]
active_colors=$active
inactive_colors=$active
disabled_colors=$disabled
EOF

# qt6ct.conf: point it at our scheme but keep everything else (icon theme,
# stylesheets…). Create it only if it doesn't exist yet.
CONFFILE="$CONF/qt6ct.conf"
if [ ! -f "$CONFFILE" ]; then
	cat > "$CONFFILE" <<EOF
[Appearance]
style=Fusion
color_scheme_path=$SCHEME
custom_palette=true
EOF
else
	if grep -q '^color_scheme_path=' "$CONFFILE"; then
		sed -i "s|^color_scheme_path=.*|color_scheme_path=$SCHEME|" "$CONFFILE"
	else
		sed -i "/^\[Appearance\]/a color_scheme_path=$SCHEME" "$CONFFILE"
	fi
	grep -q '^custom_palette=' "$CONFFILE" || \
		sed -i "/^\[Appearance\]/a custom_palette=true" "$CONFFILE"
	# the stock Artix config ships style=gtk2, which cannot work on Wayland
	if grep -q '^style=' "$CONFFILE"; then
		sed -i "s|^style=.*|style=Fusion|" "$CONFFILE"
	else
		sed -i "/^\[Appearance\]/a style=Fusion" "$CONFFILE"
	fi
fi

# fonts (added once, so GUI tweaks are kept afterwards)
if ! grep -q '^\[Fonts\]' "$CONFFILE"; then
	cat >> "$CONFFILE" <<EOF

[Fonts]
general="Gallant Raster Term,12,-1,5,50,0,0,0,0,0"
fixed="Gallant Raster Term,12,-1,5,50,0,0,0,0,0"
EOF
fi

echo "wal-qt: wrote $SCHEME"
